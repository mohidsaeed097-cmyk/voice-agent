# Copy this file to .env and paste YOUR OWN keys. Never commit .env to GitHub.

# Groq — https://console.groq.com/keys  (speech-to-text + LLM)
GROQ_API_KEY=

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys  (voice)
ELEVEN_API_KEY=

# LiveKit Cloud — https://cloud.livekit.io  -> your project -> Settings -> Keys
# Needed for "python agent.py dev" (browser). Console mode may work without them.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional
# ELEVEN_VOICE_ID=          # pick a voice from the ElevenLabs voice library
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# ELEVEN_MODEL=eleven_flash_v2_5
